[Unit]
Description=ai-family worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-family
Group=ai-family
EnvironmentFile=/etc/ai-family.env
Environment=HOME=/home/ai-family
Environment=PATH=/home/ai-family/.local/bin:/usr/local/bin:/usr/bin
Environment=AGENT_BIN=/home/ai-family/.local/bin/agent
Environment=AGENT_WORKSPACE=/var/lib/ai-family/workspace
WorkingDirectory=/opt/ai-family-runtime/current/worker
ExecStart=/usr/bin/node /opt/ai-family-runtime/current/worker/src/index.js
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=1860

[Install]
WantedBy=multi-user.target

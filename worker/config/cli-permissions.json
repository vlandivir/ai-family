{
  "approvalMode": "allowlist",
  "autoAcceptWebSearch": true,
  "permissions": {
    "allow": [
      "Shell(ls)",
      "Shell(git)",
      "Mcp(github:*)",
      "Mcp(vlandivir:*)",
      "Mcp(vlandivir-gtd:*)",
      "WebFetch(*)",
      "Read(**)",
      "Write(**)"
    ],
    "deny": [
      "Shell(rm)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Write(**/.env*)",
      "Write(**/*.key)"
    ]
  }
}
